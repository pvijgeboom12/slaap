// Cloudflare Workers (static assets + /api/contact), zelfde opzet als jcc.
// Build: npm run build → dist/. Geheimen (TURNSTILE_SECRET) zet je in het Cloudflare-dashboard, niet hier.
{
  "name": "slaap",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Alleen het contactformulier loopt via de Worker; al het andere is statisch.
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Email Routing op het subdomein post.slaapcongres.nl (account Annick/JCC; niet op het hoofddomein:
  // daar staan de MX-records van Google Workspace). Ontvanger info@slaapcongres.nl (eigen Workspace-mailbox van de stichting, in Annicks Workspace) moet geverifieerd zijn als destination address in Email Routing.
  "send_email": [{ "name": "MAIL" }],
  "vars": {
    "CONTACT_FROM": "formulier@post.slaapcongres.nl",
    "CONTACT_TO": "info@slaapcongres.nl"
  },
  "observability": { "enabled": true },
  // Nodig voor preview-builds van andere branches
  "previews": {}
}
