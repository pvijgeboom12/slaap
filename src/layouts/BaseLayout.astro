---
// Archivo zelf gehost (variabele letter met breedte-as, net als in het ontwerp). Geen Google Fonts.
import '@fontsource-variable/archivo/wdth.css';
import '../styles/site.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import { ogFoto } from '../lib/images';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { routes, type Lang, type RouteKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  page: RouteKey;
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { lang, page, title, description = '', ogImage, noindex = false } = Astro.props;

const alt = routes[page];
const canonical = new URL(alt[lang], site.url).href;
const fullTitle = `SLAAP2027 | ${title}`;
const og = ogImage ? await ogFoto(ogImage) : "/assets/slaap2027-og.png";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#12152A" />
    {(!site.indexable || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="nl" href={new URL(alt.nl, site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alt.en, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alt.nl, site.url).href} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/assets/slaap2027-beeldmerk.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SLAAP2027" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_GB'} />
    {og && <meta property="og:image" content={new URL(og, site.url).href} />}
    {og && <meta name="twitter:card" content="summary_large_image" />}
    <slot name="head" />
    {
      import.meta.env.PROD && site.cfAnalyticsToken && (
        <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })} />
      )
    }
  </head>
  <body>
    <div class="site">
      <a class="skip-link" href="#main">{lang === 'nl' ? 'Direct naar de inhoud' : 'Skip to content'}</a>
      <Header lang={lang} page={page} />
      <main id="main" tabindex="-1" style="outline:none">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <script src="../scripts/site.js"></script>
  </body>
</html>
