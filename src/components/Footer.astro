---
import { path, type Lang } from '../i18n/routes';
import { settings, congresdatum } from '../lib/content';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = {
  nl: {
    home: 'SLAAP2027, naar de homepage',
    about: ['Slaapcongres Nederland'],
    orgBy: 'Georganiseerd door',
    nswo: 'Nederlandse Vereniging voor Slaap- en Waakonderzoek (NSWO)',
    svnl: 'Slaapgeneeskunde Vereniging Nederland (SVNL)',
    under: 'verenigd in Stichting Slaap Congres Nederland (SSCN)',
    pco: 'Congresorganisatie',
    form: 'Contactformulier',
    quick: 'Snel naar',
    register: 'Registreren',
    abstract: 'Abstract indienen',
    hotel: 'Hotelkamer boeken',
    member: 'Lid worden',
    terms: 'Algemene voorwaarden',
    privacy: 'Privacyverklaring',
  },
  en: {
    home: 'SLAAP2027, to the homepage',
    about: ['Dutch Sleep Congress'],
    orgBy: 'Organised by',
    nswo: 'Dutch Society for Sleep-Wake Research (NSWO)',
    svnl: 'Dutch Society for Sleep Medicine (SVNL)',
    under: 'A joint initiative of NSWO and SVNL, organised by Stichting Slaap Congres Nederland (SSCN).',
    pco: 'Congress management',
    form: 'Contact form',
    quick: 'Quick links',
    register: 'Register',
    abstract: 'Submit an abstract',
    hotel: 'Book a hotel room',
    member: 'Become a member',
    terms: 'Terms and conditions',
    privacy: 'Privacy statement',
  },
}[lang];
const s = settings();
const fase1 = site.fase === 1;
const plaats = [s.congres?.locatie_kort || s.congres?.locatie, s.congres?.plaats].filter(Boolean).join(', ');
const quick = fase1
  ? [
      { href: path(lang, 'symposium'), label: lang === 'nl' ? 'Symposium indienen' : 'Submit symposium proposal' },
      { href: path(lang, 'locatie'), label: lang === 'nl' ? 'Locatie' : 'Venue' },
      { href: path(lang, 'contact'), label: lang === 'nl' ? 'Contact' : 'Contact' },
    ]
  : [
      { href: path(lang, 'registratie'), label: t.register },
      { href: path(lang, 'abstracts'), label: t.abstract },
      { href: path(lang, 'praktisch', 'hotel'), label: t.hotel },
      { href: path(lang, 'registratie', 'lid-worden'), label: t.member },
    ];
// Juridische links pas tonen als ze zijn ingevuld in Instellingen congres
const legal = [
  { href: s.links?.algemene_voorwaarden, label: t.terms },
  { href: s.links?.privacyverklaring || path(lang, 'privacy'), label: t.privacy },
].filter((l) => fase1 ? l.href : true);
const email = s.contact?.email ?? 'info@slaapcongres.nl';
const h2 = 'font-family:inherit;font-size:16px;font-weight:700;color:#FFFFFF;letter-spacing:0';
const col = 'display:flex;flex-direction:column;gap:10px';
---

<footer class="night" style="padding:72px 0 32px">
  <div class="wrap">
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(230px,100%),1fr));gap:40px">
      <div style="display:flex;flex-direction:column;gap:16px">
        <a href={path(lang, 'home')} style="display:inline-flex;align-items:center;min-height:48px;flex:0 0 auto"><img alt={t.home} height="32" src="/assets/slaap2027-logo-donker.svg" style="display:block;width:240px;height:32px" width="240" /></a>
        <p class="soft" style="font-size:16px;line-height:1.6">{t.about[0]}<br />{congresdatum(lang)}<br />{plaats}</p>
      </div>
      <div style={col}>
        <h2 style={h2}>{t.orgBy}</h2>
        <a class="foot-link" href="https://www.nswo.nl/">{t.nswo}</a>
        <a class="foot-link" href="https://www.slaapgeneeskundevereniging.nl/">{t.svnl}</a>
        <p class="soft" style="font-size:16px">{t.under}</p>
      </div>
      <div style={col}>
        <h2 style={h2}>{t.pco}</h2>
        <p class="soft" style="font-size:16px">JCC Congress Consultancy &amp; Events</p>
        <a class="foot-link" href={`mailto:${email}`}>{email}</a>
        <a class="foot-link" href={path(lang, 'contact')}>{t.form}</a>
      </div>
      <div style={col}>
        <h2 style={h2}>{t.quick}</h2>
        {quick.map((q) => <a class="foot-link" href={q.href}>{q.label}</a>)}
      </div>
    </div>
    <div class="soft" style="margin-top:56px;padding-top:24px;border-top:1px solid rgba(233,234,244,0.14);display:flex;flex-wrap:wrap;gap:12px 28px;justify-content:space-between;font-size:15px">
      <span>© Stichting Slaap Congres Nederland 2026</span>
      <div style="display:flex;gap:24px;flex-wrap:wrap">
        {legal.map((l) => <a class="foot-link" href={l.href || '#'}>{l.label}</a>)}
      </div>
    </div>
  </div>
</footer>
