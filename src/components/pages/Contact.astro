---
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import Photo from '../Photo.astro';
import ContactForm from '../ContactForm.astro';
import { path, type Lang } from '../../i18n/routes';
import { page, settings } from '../../lib/content';
import { site } from '../../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'contact');
const st = settings();
const email = st.contact?.email ?? 'info@slaapcongres.nl';
const sponsorMail: string = st.contact?.sponsoring_email || email;
const linkedin: string = st.links?.linkedin || '';
const quick = [path(lang, 'registratie'), path(lang, 'abstracts'), path(lang, 'sponsors'), path(lang, 'praktisch')];
const mailIcon = '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>';
---

<BaseLayout lang={lang} page="contact" title={c.seo.titel} description={c.seo.omschrijving} ogImage="slaap-netwerken_foto90.jpg">
<section class="night" style="position:relative;padding-top:clamp(80px,10vw,144px);overflow:hidden"><Photo class="hero-media" name="slaap-netwerken_foto90.jpg" alt="" priority /><div class="shade-side" aria-hidden="true"></div><div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:20px;padding-bottom:clamp(64px,8vw,104px)"><h1 style="font-size:clamp(40px,5.6vw,72px);font-weight:800;color:#FFFFFF;max-width:920px">{c.hero.titel}</h1><p class="lead" style="color:#C9CDE3;max-width:760px"><R t={c.hero.lead} lang={lang} /></p><p class="lead" style="color:#FFFFFF">{c.hero.email_label} <a href={`mailto:${email}`} style="color:#6EC3EE;font-weight:700">{email}</a></p></div></section><section class="sec"><div class="wrap" style="display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,64px);align-items:flex-start"><div class="panel" style="flex:999 1 560px;min-width:0"><ContactForm lang={lang} /></div><aside style="flex:1 1 300px;display:flex;flex-direction:column;gap:24px"><div class="panel-night" style="display:flex;flex-direction:column;gap:12px"><h2 class="h3" style="color:#FFFFFF">{c.zijbalk.organisatie_titel}</h2><p>JCC Congress Consultancy &amp; Events</p><a class="more" href={`mailto:${email}`} style="color:#6EC3EE;gap:10px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={mailIcon}></svg>{email}</a></div>{site.fase !== 1 && <div style="display:flex;flex-direction:column;gap:10px;padding:4px 4px 0"><h2 class="h3">{c.zijbalk.snel_titel}</h2>{c.zijbalk.snel.map((x: string, i: number) => <a class='more' href={quick[i]}>{x}</a>)}</div>}</aside></div></section>

<section class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8;border-bottom:1px solid #DADDE8"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:clamp(32px,5vw,64px);align-items:start">{c.sponsoring && <div style="display:flex;flex-direction:column;gap:16px"><h2 class="h2">{c.sponsoring.titel}</h2><p class="muted"><R t={c.sponsoring.tekst} lang={lang} /></p><p class="muted"><R t={c.sponsoring.oproep} lang={lang} /> <a href={`mailto:${sponsorMail}`} style="color:#155A8A;font-weight:700">{sponsorMail}</a>.</p><div><a class="btn btn-primary" href={`mailto:${sponsorMail}?subject=${encodeURIComponent(c.sponsoring.onderwerp)}`}>{c.sponsoring.knop}</a></div></div>}{c.organisatie && <div class="panel" style="display:flex;flex-direction:column;gap:12px"><h2 class="h3">{c.organisatie.titel}</h2><p><R t={c.organisatie.tekst} lang={lang} /></p><ul style="display:flex;flex-direction:column;gap:6px;padding-left:20px">{c.organisatie.leden.map((l: string) => <li>{l}</li>)}</ul><p class="muted"><R t={c.organisatie.slot} lang={lang} /></p></div>}</div></section>
{c.op_de_hoogte && <section class="sec"><div class="wrap" style="display:flex;flex-direction:column;gap:16px;max-width:820px"><h2 class="h2">{c.op_de_hoogte.titel}</h2><p class="lead"><R t={c.op_de_hoogte.tekst} lang={lang} /></p>{linkedin ? <div><a class="btn btn-outline" href={linkedin} rel="noopener">{c.op_de_hoogte.knop}</a></div> : <p><em class="ph">[LinkedIn-link volgt]</em></p>}</div></section>}

</BaseLayout>
