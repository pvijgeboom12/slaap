---
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import StatusGate from '../StatusGate.astro';
import type { Lang } from '../../i18n/routes';
import { page, settings, programma, orPh } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'registratie');
const s = settings();
const r = s.registratie ?? {};
const amount = (v: unknown) => `&#8364; ${orPh(v, lang === 'nl' ? '[bedrag]' : '[amount]')}`;
const dinerPrijs = programma().diner?.bedrag;
const dl_icon = '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>';
const lid = 'display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:6px';
const vereniging = [
  { kort: 'NSWO', ...c.lid_worden.nswo, join: 'https://www.nswo.nl/word-lid/', site: 'https://www.nswo.nl', label: 'nswo.nl' },
  { kort: 'SVNL', ...c.lid_worden.svnl, join: 'https://www.slaapgeneeskundevereniging.nl/svnl/lid-worden/', site: 'https://www.slaapgeneeskundevereniging.nl', label: 'slaapgeneeskundevereniging.nl' },
];
---

<BaseLayout lang={lang} page="registratie" title={c.seo.titel} description={c.seo.omschrijving} ogImage="/assets/slaap-hero_foto2.jpg">
<section class="night" style="position:relative;padding-top:clamp(80px,10vw,144px);overflow:hidden"><img class="hero-media" src="/assets/slaap-hero_foto2.jpg" alt="" width="1920" height="1280"><div class="shade-side" aria-hidden="true"></div><div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:20px;padding-bottom:clamp(64px,8vw,104px)"><h1 style="font-size:clamp(40px,5.6vw,72px);font-weight:800;color:#FFFFFF;max-width:920px">{c.hero.titel}</h1><p class="lead" style="color:#C9CDE3;max-width:760px"><R t={c.hero.lead} lang={lang} /></p><StatusGate kind="registratie" lang={lang} noteStyle="font-size:18px;font-weight:600;color:#6EC3EE;margin-top:8px"><div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:8px"><a class="btn btn-primary" href={r.link_individueel || '#'}>{c.hero.knop_individueel}</a><a class="btn btn-ghost" href={r.link_groep || r.link_individueel || '#'}>{c.hero.knop_groep}</a></div></StatusGate></div></section><section class="sec"><div class="wrap" style="display:flex;flex-direction:column;gap:28px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.tarieven.titel}</h2><p class="lead muted" style="max-width:760px"><R t={c.tarieven.lead} lang={lang} /></p></div><div class="tbl-box"><table class="tbl"><caption style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">{c.tarieven.bijschrift}</caption><thead><tr><th scope="col">{c.tarieven.kolom_categorie}</th><th scope="col"><R t={c.tarieven.kolom_vroegboek} lang={lang} /></th><th scope="col">{c.tarieven.kolom_regulier}</th></tr></thead><tbody>{c.tarieven.rijen.map((row: any) => <tr><td style="font-weight:600">{row.categorie}</td><td class="tabular" set:html={amount(row.vroegboek)}></td><td class="tabular" set:html={amount(row.regulier)}></td></tr>)}<tr><td style="font-weight:600">{c.tarieven.diner}</td><td class="tabular" colspan="2" set:html={amount(dinerPrijs)}></td></tr></tbody></table></div><p class="muted" style="font-size:16px"><R t={c.tarieven.voetnoot} lang={lang} /></p></div></section><section class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:40px;align-items:start"><div style="display:flex;flex-direction:column;gap:16px"><h2 class="h2">{c.groep.titel}</h2><p class="muted"><R t={c.groep.tekst} lang={lang} /></p><StatusGate kind="registratie" lang={lang} noteStyle="font-size:16px;font-weight:600"><div><a class="btn btn-outline" href={r.link_groep || r.link_individueel || '#'}>{c.groep.knop}</a></div></StatusGate></div><div style="display:flex;flex-direction:column;gap:16px"><h2 class="h2">{c.voorwaarden.titel}</h2><p class="muted"><R t={c.voorwaarden.tekst} lang={lang} /></p><div><a class="btn btn-outline" href={s.downloads?.voorwaarden_registratie_pdf || '#'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={dl_icon}></svg>{c.voorwaarden.knop}</a></div></div></div></section><section id="lid-worden" class="sec" style="scroll-margin-top:24px"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.lid_worden.titel}</h2><p class="lead muted" style="max-width:760px"><R t={c.lid_worden.lead} lang={lang} /></p></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr))">{vereniging.map((v) => <div class="panel" style="display:flex;flex-direction:column;gap:14px"><p class="disp" style="font-size:40px;font-weight:800;letter-spacing:-0.02em;line-height:1;color:#12152A">{v.kort}</p><h3 class="h3">{v.naam}</h3><p class="muted"><R t={v.tekst} lang={lang} /></p><div style={lid}><a class="btn btn-dark" href={v.join}>{v.knop}</a><a class="more" href={v.site}>{v.label}</a></div></div>)}</div></div></section>
</BaseLayout>
