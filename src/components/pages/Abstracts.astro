---
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import Photo from '../Photo.astro';
import StatusGate from '../StatusGate.astro';
import { path, type Lang } from '../../i18n/routes';
import { page, settings, fmtDate, orPh } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'abstracts');
const s = settings();
const a = s.abstracts ?? {};
const nl = lang === 'nl';
const anchors = ['richtlijnen', 'posters', 'data-blitz', 'prijzen'];
const deadlines = [
  [c.deadlines.abstracts, a.deadline_abstracts],
  [c.deadlines.symposia, a.deadline_symposia],
  [c.deadlines.acceptatie, a.bericht_acceptatie],
];
const dl_icon = '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>';
const step = 'flex:0 0 28px;height:28px;border-radius:8px;background:#12152A;color:#6EC3EE;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center';
---

<BaseLayout lang={lang} page="abstracts" title={c.seo.titel} description={c.seo.omschrijving} ogImage="slaap-sprekers_foto38.jpg">
<section class="night" style="position:relative;padding-top:clamp(80px,10vw,144px);overflow:hidden"><Photo class="hero-media" name="slaap-sprekers_foto38.jpg" alt="" priority /><div class="shade-side" aria-hidden="true"></div><div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:20px;padding-bottom:clamp(64px,8vw,104px)"><h1 style="font-size:clamp(40px,5.6vw,72px);font-weight:800;color:#FFFFFF;max-width:920px">{c.hero.titel}</h1><p class="lead" style="color:#C9CDE3;max-width:760px"><R t={c.hero.lead} lang={lang} /></p><StatusGate kind="abstracts" lang={lang} noteStyle="font-size:18px;font-weight:600;color:#6EC3EE;margin-top:8px"><div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:8px"><a class="btn btn-primary" href={a.link_abstract || '#'}>{c.hero.knop_abstract}</a><a class="btn btn-ghost" href={a.link_symposium || a.link_abstract || '#'}>{c.hero.knop_symposium}</a></div></StatusGate><nav aria-label={nl ? 'Op deze pagina' : 'On this page'} style="display:flex;flex-wrap:wrap;gap:10px;margin-top:8px">{c.hero.ankers.map((x: string, i: number) => <a class="chip" href={`#${anchors[i]}`}>{x}</a>)}</nav></div></section><section style="background:#FFFFFF;border-bottom:1px solid #DADDE8"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:0 32px;padding-top:28px;padding-bottom:28px">{deadlines.map(([label, date]) => <div style="display:flex;flex-direction:column;gap:4px;padding:26px 24px 26px 0;border-top:3px solid #E8352B"><span class="muted" style="font-weight:600;font-size:16px">{label}</span><span class="disp" style="font-size:26px;font-weight:700" set:html={orPh(fmtDate(date, lang), nl ? '[datum]' : '[date]')}></span></div>)}</div></section><section id="richtlijnen" class="sec" style="scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,88px);align-items:start"><div style="display:flex;flex-direction:column;gap:20px"><h2 class="h2">{c.richtlijnen.titel}</h2><ul class="rule-list" style="list-style:none">{c.richtlijnen.punten.map((p: string) => <li><span class="dot" aria-hidden="true"></span><span><R t={p} lang={lang} /></span></li>)}</ul><div style="display:flex;flex-wrap:wrap;gap:12px"><StatusGate kind="abstracts" lang={lang} noteStyle="flex:1 1 100%;font-weight:600"><a class="btn btn-dark" href={a.link_abstract || '#'}>{c.richtlijnen.knop_abstract}</a></StatusGate><a class="btn btn-outline" href={s.downloads?.voorwaarden_abstracts_pdf || '#'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={dl_icon}></svg>{c.richtlijnen.knop_voorwaarden}</a></div></div><div class="panel" style="display:flex;flex-direction:column;gap:16px"><h3 class="h3">{c.opbouw.titel}</h3><ol style="list-style:none;display:flex;flex-direction:column;gap:8px">{c.opbouw.onderdelen.map((o: string, i: number) => <li style="display:flex;align-items:center;gap:14px;padding:12px 16px;border-radius:12px;background:#F3F4F9"><span class="tabular" style={step}>{i + 1}</span><span lang="en" style="font-weight:700">{o}</span></li>)}</ol><p class="muted" style="font-size:16px"><R t={c.opbouw.voetnoot} lang={lang} /></p><div style="height:1px;background:#E6E8F0;margin:6px 0"></div><h3 class="h3">{c.opbouw.symposium_titel}</h3><p class="muted"><R t={c.opbouw.symposium_tekst} lang={lang} /></p></div></div></section><section id="posters" class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8;scroll-margin-top:24px"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.posters.titel}</h2><p class="lead muted" style="max-width:760px"><R t={c.posters.lead} lang={lang} /></p></div><figure style="margin:0;height:clamp(240px,32vw,440px)"><Photo class="photo" name="slaap-posters_foto199.jpg" alt={c.posters.foto_alt} sizes="(max-width: 760px) 100vw, 50vw" /></figure><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr))">{c.posters.blokken.map((b: any) => <div class="panel" style="display:flex;flex-direction:column;gap:10px"><h3 class="h3">{b.titel}</h3><p class="muted"><R t={b.tekst} lang={lang} /></p></div>)}</div></div></section><section id="data-blitz" class="sec night" style="scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,88px);align-items:center"><div style="display:flex;flex-direction:column;gap:18px"><h2 class="h2" style="color:#FFFFFF">{c.data_blitz.titel}</h2><p class="lead" style="color:#C9CDE3"><R t={c.data_blitz.lead} lang={lang} /></p><p class="soft"><R t={c.data_blitz.tekst} lang={lang} /></p></div><div class="panel-night grid" style={`grid-template-columns:repeat(${c.data_blitz.feiten.length},minmax(0,1fr));gap:20px`}>{c.data_blitz.feiten.map((f: any) => <div style="display:flex;flex-direction:column;gap:4px"><span class="disp" style="font-size:clamp(36px,4vw,52px);font-weight:800;line-height:1;color:#FFFFFF">{f.waarde}</span><span class="soft" style="font-size:16px">{f.label}</span></div>)}</div></div></section><section id="prijzen" class="sec" style="scroll-margin-top:24px"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.prijzen.titel}</h2><p class="lead muted" style="max-width:760px"><R t={c.prijzen.lead} lang={lang} /></p></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))"><div class="panel" style="display:flex;flex-direction:column;gap:12px"><h3 class="h3">{c.prijzen.publiek_titel}</h3><p class="muted"><R t={c.prijzen.publiek_tekst} lang={lang} /></p></div><div class="panel" style="display:flex;flex-direction:column;gap:12px;border:2px solid #12152A"><h3 class="h3">{c.prijzen.pv_titel}</h3><p class="muted"><R t={c.prijzen.pv_tekst} lang={lang} /></p><p style="font-weight:600"><R t={c.prijzen.pv_voorwaarde} lang={lang} /> <a href={path(lang, 'registratie', 'lid-worden')}>{c.prijzen.pv_link}</a></p></div><figure style="margin:0;display:flex;flex-direction:column;gap:10px"><div style="height:clamp(220px,22vw,300px)"><Photo class="photo" name="slaap-awards_foto331.jpg" alt={c.prijzen.foto_alt} sizes="(max-width: 760px) 100vw, 50vw" /></div><figcaption class="muted" style="font-size:15px">{c.prijzen.foto_bijschrift}</figcaption></figure></div></div></section>
</BaseLayout>
