---
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import { path, type Lang } from '../../i18n/routes';
import { upload } from '../../lib/images';
import { page, settings, programma, sprekers, tr, toDate, dayName, monthName, cap, orPh, PH, fmtDate } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'programma');
const s = settings();
const p = programma();
const nl = lang === 'nl';

const types: Record<string, { cls: string; nl: string; en: string }> = {
  keynote: { cls: 'tag-keynote', nl: 'Keynote', en: 'Keynote' },
  symposia: { cls: 'tag-sym', nl: 'Symposia', en: 'Symposia' },
  posters: { cls: 'tag-poster', nl: 'Posters', en: 'Posters' },
  plenair: { cls: 'tag-plenair', nl: 'Plenair', en: 'Plenary' },
  sociaal: { cls: 'tag-social', nl: 'Sociaal', en: 'Social' },
};
const dagen = (p.dagen ?? []).map((d: any) => {
  const date = toDate(d.datum)!;
  const short = `${cap(dayName(date, lang)).slice(0, nl ? 2 : 3)} ${date.getUTCDate()} ${monthName(date, lang).slice(0, 3)}`;
  return { ...d, tab: nl ? short : short.replace(/ (\w)/g, (m) => m.toUpperCase()), kop: cap(`${dayName(date, lang)} ${fmtDate(date, lang)}`) };
});
const sprekersLijst = await Promise.all(sprekers().map(async (sp: any) => ({ ...sp, img: await upload(sp.foto, 192) })));
const roomPh = (type: string) => (type === 'symposia' ? (nl ? '[zalen]' : '[rooms]') : nl ? '[zaal]' : '[room]');
const pdf = (u: string) => u || '#';
const anchors = ['overzicht', 'sprekers', 'posters', 'congresdiner'];

const diner = p.diner ?? {};
const dinerDate = toDate(diner.datum);
const dinerDatum = dinerDate
  ? cap(`${dayName(dinerDate, lang)} ${fmtDate(dinerDate, lang)}`)
  : `${PH(nl ? '[dag]' : '[day]')} ${PH(nl ? '[datum]' : '[date]')} ${nl ? 'november' : 'November'} 2027`;

const rowStyle = 'display:flex;flex-wrap:wrap;gap:8px 28px;align-items:baseline;padding:20px clamp(20px,2.6vw,32px);border-bottom:1px solid #E6E8F0';
const dl = 'display:flex;flex-wrap:wrap;gap:4px 24px;padding:16px 0;border-bottom:1px solid rgba(110,195,238,0.16)';
const dt = 'flex:0 0 110px;font-weight:700;color:#A9D9F4';
const dd = 'margin:0;flex:1 1 200px;color:#FFFFFF';
const dl_icon = '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>';
---

<BaseLayout lang={lang} page="programma" title={c.seo.titel} description={c.seo.omschrijving} ogImage="/assets/slaap-hero_foto3.jpg">
<section class="night" style="position:relative;padding-top:clamp(80px,10vw,144px);overflow:hidden"><img class="hero-media" src="/assets/slaap-hero_foto3.jpg" alt="" width="1920" height="1280"><div class="shade-side" aria-hidden="true"></div><div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:20px;padding-bottom:clamp(64px,8vw,104px)"><h1 style="font-size:clamp(40px,5.6vw,72px);font-weight:800;color:#FFFFFF;max-width:920px">{c.hero.titel}</h1><p class="lead" style="color:#C9CDE3;max-width:760px"><R t={c.hero.lead} lang={lang} /></p><nav aria-label={nl ? 'Op deze pagina' : 'On this page'} style="display:flex;flex-wrap:wrap;gap:10px;margin-top:8px">{c.hero.ankers.map((a: string, i: number) => <a class="chip" href={`#${anchors[i]}`}>{a}</a>)}</nav></div></section><section id="overzicht" class="sec" style="scroll-margin-top:24px"><div class="wrap" style="display:flex;flex-direction:column;gap:28px"><div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.overzicht.titel}</h2><p class="lead muted" style="max-width:760px"><R t={c.overzicht.lead} lang={lang} /></p></div><a class="btn btn-outline" href={pdf(s.downloads?.programma_pdf)}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={dl_icon}></svg>{c.overzicht.knop_pdf}</a></div><div role="group" aria-label={c.overzicht.kies_dag} style="display:flex;flex-wrap:wrap;gap:10px">{dagen.map((d: any, i: number) => <button type="button" class={i === 0 ? 'tab on' : 'tab '} aria-pressed={i === 0 ? 'true' : 'false'}>{d.tab}</button>)}</div>{dagen.map((d: any, i: number) => (
<div data-daypanel hidden={i > 0}><div class="panel" style="padding:0;overflow:hidden"><h3 class="h3" style="padding:22px clamp(20px,2.6vw,32px);border-bottom:1px solid #DADDE8;background:#F3F4F9">{d.kop}</h3><ol style="list-style:none">{(d.sessies ?? []).map((x: any) => {
  const t = types[x.type] ?? types.plenair;
  const title = tr(x.titel, lang);
  const meta = [x.sprekers && `${c.overzicht[x.sprekers.includes(',') ? 'sprekers' : 'spreker']}: ${x.sprekers}`, x.voorzitter && `${c.overzicht.voorzitter}: ${x.voorzitter}`].filter(Boolean).join(' · ');
  return <li style={rowStyle}><span class="tabular" style="flex:0 0 96px;font-weight:700" set:html={orPh(x.tijd, nl ? '[tijd]' : '[time]')}></span><span style="flex:1 1 320px;display:flex;flex-direction:column;gap:6px;align-items:flex-start"><span class={`tag ${t.cls}`}>{t[lang]}</span><span style="font-size:19px;font-weight:600"><span class={/\[/.test(title) ? 'ph' : ''}>{title}</span></span>{meta && <span class="muted" style="font-size:16px">{meta}</span>}</span><span class="muted" style="flex:0 0 140px;font-size:16px">{x.zaal || roomPh(x.type)}</span></li>;
})}</ol></div></div>
))}</div></section><section id="sprekers" class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8;scroll-margin-top:24px"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.sprekers.titel}</h2></div><ul class="grid" style="list-style:none;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr))">{sprekersLijst.map((sp: any) => {
  const t = types[sp.type] ?? types.keynote;
  return <li class="panel" style="display:flex;flex-direction:column;gap:14px">{sp.img
    ? <img src={sp.img.src} alt="" width="96" height="96" loading="lazy" style="display:block;width:96px;height:96px;border-radius:50%;object-fit:cover" />
    : <span aria-hidden="true" style="display:flex;align-items:center;justify-content:center;width:96px;height:96px;border-radius:50%;background:#E6E8F0;color:#7FA9CB"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg></span>}<span class={`tag ${t.cls}`} style="align-self:flex-start">{t[lang]}</span><h3 class="h3" set:html={orPh(sp.naam, nl ? '[Naam spreker]' : '[Speaker name]')}></h3><p class="muted" style="font-size:16px" set:html={orPh(tr(sp.functie, lang), nl ? '[Functie, instelling]' : '[Role, institution]')}></p><p style="font-weight:600" set:html={orPh(tr(sp.lezing, lang), nl ? '[Titel lezing]' : '[Talk title]')}></p>{tr(sp.bio, lang) && <p class="muted" style="font-size:16px"><R t={tr(sp.bio, lang)} lang={lang} /></p>}</li>;
})}</ul></div></section><section id="posters" class="sec" style="scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:40px;align-items:start"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.posters.titel}</h2><p class="lead muted" style="max-width:760px"><R t={c.posters.lead} lang={lang} /></p></div><div class="panel" style="display:flex;flex-direction:column;gap:16px;align-items:flex-start"><p><R t={c.posters.tekst} lang={lang} /></p><div style="display:flex;flex-wrap:wrap;gap:12px"><a class="btn btn-dark" href={pdf(s.downloads?.posteroverzicht_pdf)}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={dl_icon}></svg>{c.posters.knop_pdf}</a><a class='btn btn-outline' href={path(lang, 'abstracts', 'posters')}>{c.posters.knop_info}</a></div></div></div></section><section id="congresdiner" class="sec night" style="scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,88px);align-items:start"><div style="display:flex;flex-direction:column;gap:20px"><p class="kicker">{c.diner.kicker}</p><h2 class="h2" style="color:#FFFFFF">{c.diner.titel}</h2><p class="lead" style="color:#C9CDE3"><R t={c.diner.lead} lang={lang} /></p><p class="soft"><R t={c.diner.tekst} lang={lang} /></p><div><a class="btn btn-primary" href={s.registratie?.link_dinerticket || '#'}>{c.diner.knop}</a></div></div><dl class="panel-night" style="margin:0;display:grid;grid-template-columns:minmax(0,1fr);gap:0"><div style={dl}><dt style={dt}>{c.diner.label_datum}</dt><dd style={dd} set:html={dinerDatum}></dd></div><div style={dl}><dt style={dt}>{c.diner.label_tijd}</dt><dd style={dd}>{c.diner.vanaf} <Fragment set:html={orPh(diner.tijd, nl ? '[tijd]' : '[time]')} /></dd></div><div style={dl}><dt style={dt}>{c.diner.label_locatie}</dt><dd style={dd}>{s.congres.locatie_kort}, <Fragment set:html={orPh(diner.zaal, nl ? '[zaal]' : '[room]')} /></dd></div><div style={dl}><dt style={dt}>{c.diner.label_kosten}</dt><dd style={dd}>&#8364; <Fragment set:html={orPh(diner.bedrag, nl ? '[bedrag]' : '[amount]')} /> {c.diner.btw}</dd></div></dl></div><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(360px,100%),1fr));gap:16px;margin-top:clamp(40px,5vw,64px)"><figure style="margin:0;height:clamp(240px,28vw,380px)"><img class="photo" src="/assets/slaap-diner-feest_foto252.jpg" alt={c.diner.alt[0]} loading="lazy"></figure><figure style="margin:0;height:clamp(240px,28vw,380px)"><img class="photo" src="/assets/slaap-diner-feest_foto206.jpg" alt={c.diner.alt[1]} loading="lazy"></figure></div></section>
</BaseLayout>
