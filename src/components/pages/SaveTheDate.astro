---
// Homepage in fase 1: intro, wat je kunt verwachten, voor wie, Call for Symposia en locatie.
// Teksten: src/content/pages/{nl,en}/savethedate.yml (Annick, 23 november 2026). Datums en locatie: settings.yml.
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import Photo from '../Photo.astro';
import EventJsonLd from '../EventJsonLd.astro';
import { path, type Lang } from '../../i18n/routes';
import { page, settings, toDate, dayName, monthName, cap } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'savethedate');
const s = settings();
const cg = s.congres;

const start = toDate(cg.startdatum)!;
const end = toDate(cg.einddatum) ?? start;
const days: Date[] = [];
for (let d = new Date(start); d <= end; d = new Date(d.getTime() + 86400000)) days.push(d);
const monthLabel = `${cap(monthName(start, lang))} ${start.getUTCFullYear()}`;

type Punt = { icoon: string; titel: string; tekst: string };
// Iconen bij "Wat kun je verwachten?" (sleutel = veld icoon in savethedate.yml)
const icons: Record<string, string> = {
  keynote: '<rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8"></path>',
  symposia: '<rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M7 20h10M12 16v4M7 9h4M7 12h7"></path>',
  presentatie: '<path d="M3 4h18M5 4v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4M12 16v4M9 20h6M8 12l3-3 2 2 3-3"></path>',
  poster: '<rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M8 7h8M8 11h8M8 15h5"></path>',
  eerstelijn: '<path d="M6 3v6a4 4 0 0 0 8 0V3M10 13v2a5 5 0 0 0 10 0v-2"></path><circle cx="20" cy="11" r="2"></circle>',
  markt: '<path d="M4 9l1.5-5h13L20 9M4 9v11h16V9M4 9h16M9 20v-6h6v6"></path>',
  avond: '<path d="M8 3h8l-1 7a3 3 0 0 1-6 0zM12 13v7M8 21h8"></path>',
};
// Call for Symposia: tekst en knoppen wisselen vanzelf zodra abstracts.status op open staat (Instellingen congres).
const ab = s.abstracts ?? {};
const cfsOpen = ab.status === 'open';
const formLink: string = cfsOpen ? ab.link_symposium || '' : '';
const cfsHref = formLink || path(lang, 'symposium');
const cfsTekst = (cfsOpen && c.programma.tekst_open) || c.programma.tekst;
const cfsKnop = (cfsOpen && c.programma.knop_open) || c.programma.knop;
const heroCfs = (cfsOpen && c.hero.knop_symposia_open) || c.hero.knop_symposia;
const pin = '<path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"></circle>';
---

<BaseLayout lang={lang} page="home" title={c.seo.titel} description={c.seo.omschrijving} ogImage="slaap-hero_foto272.jpg">
<EventJsonLd slot="head" lang={lang} />
<div lang={lang}>

<section class="night" style="position:relative;overflow:hidden"><Photo class="hero-media" name="slaap-hero_foto272.jpg" alt="" priority /><div class="shade-home" aria-hidden="true"></div><div class="wrap" style="position:relative;padding-top:clamp(80px,11vw,168px);padding-bottom:clamp(56px,7vw,96px);display:flex;flex-direction:column;gap:clamp(40px,5vw,64px)"><div style="display:flex;flex-direction:column;gap:clamp(16px,2vw,24px)"><p style="font-size:clamp(20px,1.8vw,24px);font-weight:600;color:#C9CDE3">{c.hero.kicker}</p><h1 style="margin:0;line-height:0"><img src="/assets/slaap2027-logo-donker.svg" alt="SLAAP2027" width="1104" height="147" style="display:block;width:100%;max-width:1104px;height:auto"></h1></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:40px;align-items:end"><div style="display:flex;flex-direction:column;gap:22px"><p class="lead" style="color:#E9EAF4;max-width:540px"><R t={c.hero.lead} lang={lang} /></p><div style="display:flex;flex-wrap:wrap;gap:12px"><a class='btn btn-primary' href={cfsHref} rel={formLink ? 'noopener' : undefined}>{heroCfs}</a><a class='btn btn-ghost' href={path(lang, 'locatie')}>{c.hero.knop_locatie ?? c.hero.link_locatie}</a></div></div><div class="panel-night" style="display:flex;flex-direction:column;gap:22px;width:100%;max-width:460px;justify-self:end"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap"><p style="font-weight:700;color:#A9D9F4">{monthLabel}</p><p style="font-size:14px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#6EC3EE">{c.hero.label}</p></div><div class="grid" style={`grid-template-columns:repeat(${days.length},minmax(0,1fr));gap:12px`}>{days.map((d) => <div style="display:flex;flex-direction:column;gap:6px"><span class="disp tabular" style="font-size:clamp(48px,5vw,68px);font-weight:700;line-height:1;color:#FFFFFF">{d.getUTCDate()}</span><span style="font-size:15px;font-weight:600;color:#A9AECB">{dayName(d, lang)}</span></div>)}</div><div style="height:1px;background:rgba(110,195,238,0.2)"></div><div style="display:flex;gap:12px;align-items:flex-start"><span style="color:#6EC3EE;margin-top:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pin}></svg></span><div><p style="font-weight:700;color:#FFFFFF">{cg.locatie}</p><p class="soft">{cg.plaats}</p></div></div><a class='more' href={path(lang, 'locatie')} style='color:#6EC3EE'>{c.hero.link_locatie}</a></div></div></div></section>

<section class="sec"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:start"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">{c.intro.titel}</h2><p class="lead"><R t={c.intro.lead} lang={lang} /></p><p class="muted"><R t={c.intro.tekst} lang={lang} /></p><p class="muted"><R t={c.intro.organisatie} lang={lang} /></p></div><div class="panel" style="display:flex;flex-direction:column;gap:14px"><h3 class="h3">{c.voor_wie.titel}</h3><p class="muted"><R t={c.voor_wie.tekst} lang={lang} /></p></div></div></section>

<section id="programma" class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8;border-bottom:1px solid #DADDE8"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:18px;max-width:820px"><h2 class="h2">{c.verwachten.titel}</h2><p class="lead"><R t={c.verwachten.lead} lang={lang} /></p><p class="muted"><R t={c.verwachten.taal} lang={lang} /></p></div><ul class="grid" style="list-style:none;padding:0;margin:0;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:16px">{c.verwachten.punten.map((p: Punt) => <li class="panel" style="display:flex;flex-direction:column;gap:14px;align-items:flex-start;padding:24px"><span class="action-icon" style="width:48px;height:48px"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[p.icoon] ?? icons.symposia}></svg></span><div style="display:flex;flex-direction:column;gap:6px"><h3 class="h3" style="font-size:20px">{p.titel}</h3><p class="muted" style="font-size:16px"><R t={p.tekst} lang={lang} /></p></div></li>)}</ul></div></section>

<section id="call-for-symposia" class="night" style="padding:clamp(64px,8vw,104px) 0"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:center"><div style="display:flex;flex-direction:column;gap:16px"><h2 class="h2" style="color:#FFFFFF">{c.programma.titel}</h2><p class="lead" style="color:#C9CDE3"><R t={cfsTekst} lang={lang} /></p></div><div><a class="btn btn-primary" href={cfsHref} rel={formLink ? 'noopener' : undefined}>{cfsKnop}</a></div></div></section>

<section id="locatie" class="sec"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:center"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">{c.locatie.titel}</h2><p class="lead"><R t={c.locatie.tekst} lang={lang} /></p><div><a class="btn btn-outline" href={path(lang, 'locatie')}>{c.locatie.knop}</a></div></div><figure style="margin:0;border-radius:20px;overflow:hidden;aspect-ratio:4 / 3"><Photo name="slaap-publiek_foto287.jpg" alt={lang === 'nl' ? 'Publiek tijdens een sessie op SLAAP2025 in NH Koningshof' : 'Audience during a session at SLAAP2025 in NH Koningshof'} sizes="(max-width: 760px) 100vw, 50vw" style="display:block;width:100%;height:100%;object-fit:cover" /></figure></div></section>

</div>
</BaseLayout>
