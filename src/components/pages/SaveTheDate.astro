---
// Homepage in fase 1 (save the date): intro, datum, locatie, Call for Symposia en een doorverwijzing naar Contact.
// Teksten: src/content/pages/{nl,en}/savethedate.yml. Datums, locatie en links: settings.yml.
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import Photo from '../Photo.astro';
import EventJsonLd from '../EventJsonLd.astro';
import ContactForm from '../ContactForm.astro';
import { path, type Lang } from '../../i18n/routes';
import { page, settings, toDate, dayName, monthName, cap, fmtDate } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'savethedate');
const s = settings();
const cg = s.congres;

const start = toDate(cg.startdatum)!;
const end = toDate(cg.einddatum) ?? start;
const days: Date[] = [];
for (let d = new Date(start); d <= end; d = new Date(d.getTime() + 86400000)) days.push(d);
const monthLabel = `${cap(monthName(start, lang))} ${start.getUTCFullYear()}`;

const adres = [cg.adres, [cg.postcode, cg.plaats].filter(Boolean).join(' ')].filter(Boolean).join(', ');
const routeUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([cg.locatie_volledig || cg.locatie, adres].filter(Boolean).join(', '))}`;

// Call for Symposia volgt de status van "Abstracts" in Instellingen congres
const ab = s.abstracts ?? {};
const symStatus: string = ab.status ?? 'binnenkort';
const symLink: string = ab.link_symposium || '';
const symDeadline = fmtDate(ab.deadline_symposia, lang);
const symMelding =
  symStatus === 'gesloten' ? c.symposia.gesloten
  : symStatus === 'open' && symLink ? ''
  : ab.opent_op ? c.symposia.binnenkort
  : c.symposia.volgt;

const email: string = s.contact?.email ?? 'info@jcc-congress.com';
const sponsorMail: string = s.contact?.sponsoring_email || '';

const pin = '<path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"></circle>';
---

<BaseLayout lang={lang} page="home" title={c.seo.titel} description={c.seo.omschrijving} ogImage="slaap-hero_foto272.jpg">
<EventJsonLd slot="head" lang={lang} />
<div lang={lang}>

<section class="night" style="position:relative;overflow:hidden"><Photo class="hero-media" name="slaap-hero_foto272.jpg" alt="" priority /><div class="shade-home" aria-hidden="true"></div><div class="wrap" style="position:relative;padding-top:clamp(80px,11vw,168px);padding-bottom:clamp(56px,7vw,96px);display:flex;flex-direction:column;gap:clamp(40px,5vw,64px)"><div style="display:flex;flex-direction:column;gap:clamp(16px,2vw,24px)"><p style="font-size:clamp(20px,1.8vw,24px);font-weight:600;color:#C9CDE3">{c.hero.kicker}</p><h1 style="margin:0;line-height:0"><img src="/assets/slaap2027-woordmerk-donker.svg" alt="SLAAP2027" width="1104" height="142" style="display:block;width:100%;max-width:1104px;height:auto"></h1></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:40px;align-items:end"><div style="display:flex;flex-direction:column;gap:22px"><p class="lead" style="color:#E9EAF4;max-width:540px"><R t={c.hero.lead} lang={lang} /></p><div style="display:flex;flex-wrap:wrap;gap:12px"><a class='btn btn-primary' href="#call-for-symposia">{c.hero.knop_symposia}</a><a class='btn btn-ghost' href="#contact">{c.hero.knop_contact}</a></div></div><div class="panel-night" style="display:flex;flex-direction:column;gap:22px;width:100%;max-width:460px;justify-self:end"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap"><p style="font-weight:700;color:#A9D9F4">{monthLabel}</p><p style="font-size:14px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#6EC3EE">{c.hero.label}</p></div><div class="grid" style={`grid-template-columns:repeat(${days.length},minmax(0,1fr));gap:12px`}>{days.map((d) => <div style="display:flex;flex-direction:column;gap:6px"><span class="disp tabular" style="font-size:clamp(48px,5vw,68px);font-weight:700;line-height:1;color:#FFFFFF">{d.getUTCDate()}</span><span style="font-size:15px;font-weight:600;color:#A9AECB">{dayName(d, lang)}</span></div>)}</div><div style="height:1px;background:rgba(110,195,238,0.2)"></div><div style="display:flex;gap:12px;align-items:flex-start"><span style="color:#6EC3EE;margin-top:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pin}></svg></span><div><p style="font-weight:700;color:#FFFFFF">{cg.locatie}</p><p class="soft">{cg.plaats}</p></div></div><a class='more' href="#locatie" style='color:#6EC3EE'>{c.locatie.titel}</a></div></div></div></section>

<section class="sec"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:start"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">{c.intro.titel}</h2><p class="lead"><R t={c.intro.lead} lang={lang} /></p><p class="muted"><R t={c.intro.tekst} lang={lang} /></p></div><div class="panel" style="display:flex;flex-direction:column;gap:8px"><h3 class="h3">{c.intro.voor_wie_titel}</h3><ul class="rule-list" style="list-style:none">{c.intro.voor_wie.map((p: string) => <li><span class="dot" aria-hidden="true"></span><span><R t={p} lang={lang} /></span></li>)}</ul></div></div></section>

<section id="call-for-symposia" class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8;border-bottom:1px solid #DADDE8;scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:start"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">{c.symposia.titel}</h2><p class="lead"><R t={c.symposia.lead} lang={lang} /></p><p class="muted"><R t={c.symposia.tekst} lang={lang} /></p></div><div class="panel-night" style="display:flex;flex-direction:column;gap:18px">{symDeadline && <div style="display:flex;flex-direction:column;gap:4px"><p class="soft" style="font-size:16px;font-weight:600">{c.symposia.deadline}</p><p class="disp" style="font-size:clamp(26px,2.6vw,34px);font-weight:700;color:#FFFFFF">{symDeadline}</p></div>}{symMelding && <p style="color:#E9EAF4"><R t={symMelding} lang={lang} /></p>}{symStatus === 'open' && symLink && <div><a class="btn btn-primary" href={symLink}>{c.symposia.knop}</a></div>}<div style="height:1px;background:rgba(110,195,238,0.2)"></div><p class="soft" style="font-size:16px">{c.symposia.vraag} <a href="#contact" style="color:#6EC3EE;font-weight:700">{c.symposia.vraag_link}</a></p></div></div></section>

<section id="locatie" class="sec" style="scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:center"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">{c.locatie.titel}</h2><p class="lead"><R t={c.locatie.tekst} lang={lang} /></p><div style="display:flex;gap:12px;align-items:flex-start"><span style="color:#155A8A;margin-top:3px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pin}></svg></span><div><p style="font-weight:700">{cg.locatie_volledig || cg.locatie}</p><p class="muted">{adres}</p><a class="more" href={routeUrl} rel="noopener">{c.hero.link_route}</a></div></div></div><figure style="margin:0;border-radius:20px;overflow:hidden;aspect-ratio:4 / 3"><Photo name="slaap-publiek_foto287.jpg" alt={lang === 'nl' ? 'Publiek tijdens een sessie op SLAAP2025 in NH Koningshof' : 'Audience during a session at SLAAP2025 in NH Koningshof'} sizes="(max-width: 760px) 100vw, 50vw" style="display:block;width:100%;height:100%;object-fit:cover" /></figure></div></section>

<section id="sponsors" class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8;scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:center"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">{c.sponsors.titel}</h2><p class="lead"><R t={c.sponsors.lead} lang={lang} /></p><p class="muted"><R t={c.sponsors.tekst} lang={lang} /></p></div><div class="panel" style="display:flex;flex-direction:column;gap:18px;align-items:flex-start"><a class="btn btn-primary" href="#contact">{c.sponsors.knop}</a>{sponsorMail && <p class="muted">{c.sponsors.mail_label} <a href={`mailto:${sponsorMail}`} style="color:#155A8A;font-weight:700">{sponsorMail}</a></p>}</div></div></section>

<section id="contact" class="night" style="padding:clamp(64px,8vw,104px) 0;border-bottom:1px solid rgba(233,234,244,0.1);scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:start"><div style="display:flex;flex-direction:column;gap:16px"><h2 class="h2" style="color:#FFFFFF">{c.afsluiter.titel}</h2><p class="lead" style="color:#C9CDE3"><R t={c.afsluiter.tekst} lang={lang} /></p><p class="soft">{c.afsluiter.mail_label} <a href={`mailto:${email}`} style="color:#6EC3EE;font-weight:700">{email}</a></p></div><div class="panel" style="color:#1B2140"><ContactForm lang={lang} titel={c.afsluiter.formulier_titel} /></div></div></section>

</div>
</BaseLayout>
