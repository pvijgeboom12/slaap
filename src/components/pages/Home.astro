---
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import Photo from '../Photo.astro';
import SponsorTiles from '../SponsorTiles.astro';
import EventJsonLd from '../EventJsonLd.astro';
import { path, type Lang } from '../../i18n/routes';
import { page, settings, comite, tr, toDate, dayName, monthName, cap, orPh } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'home');
const s = settings();
const status = s.registratie?.status ?? 'binnenkort';

// Datumblok in de hero: alle dagen van start- t/m einddatum
const start = toDate(s.congres.startdatum)!;
const end = toDate(s.congres.einddatum) ?? start;
const days: Date[] = [];
for (let d = new Date(start); d <= end; d = new Date(d.getTime() + 86400000)) days.push(d);
const monthLabel = `${cap(monthName(start, lang))} ${start.getUTCFullYear()}`;

const blockLinks = [path(lang, 'praktisch'), path(lang, 'programma'), path(lang, 'praktisch', 'accreditatie')];
const actionLinks = [path(lang, 'registratie'), path(lang, 'abstracts'), path(lang, 'praktisch', 'hotel'), path(lang, 'sponsors'), path(lang, 'registratie', 'lid-worden')];
const photos = [
  ['slaap-sprekers_foto73.jpg', 'wide', 'grid-column:1 / span 3;grid-row:1 / span 4'],
  ['slaap-posters_foto199.jpg', '', 'grid-column:4 / span 3;grid-row:1 / span 2'],
  ['slaap-netwerken_foto99.jpg', '', 'grid-column:4 / span 2;grid-row:3 / span 2'],
  ['slaap-publiek_foto287.jpg', '', 'grid-column:6 / span 1;grid-row:3 / span 2'],
  ['slaap-diner-feest_foto230.jpg', 'wide', 'grid-column:1 / span 4;grid-row:5 / span 3'],
  ['slaap-awards_foto331.jpg', '', 'grid-column:5 / span 2;grid-row:5 / span 3'],
];
const icons = [
  '<path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4z"></path><path d="M14 6v12" stroke-dasharray="2 2.5"></path>',
  '<path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5M10 13h6M10 17h6"></path>',
  '<path d="M3 18V7M3 14h18v4M21 14v-2a3 3 0 0 0-3-3h-7v5"></path><circle cx="7" cy="11" r="2"></circle>',
  '<circle cx="12" cy="9" r="5.5"></circle><path d="M8.6 13.6L7 21l5-3 5 3-1.6-7.4"></path>',
  '<circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.6a3.5 3.5 0 0 1 0 6.8M17.5 14.4a6.5 6.5 0 0 1 4 5.6"></path>',
];
const phName = lang === 'nl' ? '[Naam]' : '[Name]';
const phRole = lang === 'nl' ? '[Functie, instelling]' : '[Role, institution]';
---

<BaseLayout lang={lang} page="home" title={c.seo.titel} description={c.seo.omschrijving} ogImage="slaap-hero_foto272.jpg">
<EventJsonLd slot="head" lang={lang} />
<div lang={lang}><section class="night" style="position:relative;overflow:hidden"><Photo class="hero-media" name="slaap-hero_foto272.jpg" alt="" priority /><div class="shade-home" aria-hidden="true"></div><div class="wrap" style="position:relative;padding-top:clamp(80px,11vw,168px);padding-bottom:clamp(56px,7vw,96px);display:flex;flex-direction:column;gap:clamp(40px,5vw,64px)"><div style="display:flex;flex-direction:column;gap:clamp(16px,2vw,24px)"><p style="font-size:clamp(20px,1.8vw,24px);font-weight:600;color:#C9CDE3">{c.hero.kicker}</p><h1 style="margin:0;line-height:0"><img src="/assets/slaap2027-logo-donker.svg" alt="SLAAP2027" width="1104" height="147" style="display:block;width:100%;max-width:1104px;height:auto"></h1></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:40px;align-items:end"><div style="display:flex;flex-direction:column;gap:22px"><p class="lead" style="color:#E9EAF4;max-width:540px"><R t={c.hero.lead} lang={lang} /></p><div style="display:flex;flex-wrap:wrap;gap:12px"><a class='btn btn-primary' href={path(lang, 'registratie')}>{c.hero.knop_registreren}</a><a class='btn btn-ghost' href={path(lang, 'abstracts')}>{c.hero.knop_abstract}</a></div><p style="font-size:16px;color:#A9AECB"><R t={c.hero.status[status]} lang={lang} /></p></div><div class="panel-night" style="display:flex;flex-direction:column;gap:22px;width:100%;max-width:460px;justify-self:end"><p style="font-weight:700;color:#A9D9F4">{monthLabel}</p><div class="grid" style={`grid-template-columns:repeat(${days.length},minmax(0,1fr));gap:12px`}>{days.map((d) => <div style="display:flex;flex-direction:column;gap:6px"><span class="disp tabular" style="font-size:clamp(48px,5vw,68px);font-weight:700;line-height:1;color:#FFFFFF">{d.getUTCDate()}</span><span style="font-size:15px;font-weight:600;color:#A9AECB">{dayName(d, lang)}</span></div>)}</div><div style="height:1px;background:rgba(110,195,238,0.2)"></div><div style="display:flex;gap:12px;align-items:flex-start"><span style="color:#6EC3EE;margin-top:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"></circle></svg></span><div><p style="font-weight:700;color:#FFFFFF">{s.congres.locatie}</p><p class="soft">{s.congres.plaats}</p></div></div><a class='more' href={path(lang, 'praktisch')} style='color:#6EC3EE'>{c.hero.link_route}</a></div></div></div></section><section style="background:#FFFFFF;border-bottom:1px solid #DADDE8"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:0 32px">{c.blokken.map((b: any, i: number) => <div style="padding:30px 28px 26px 0;display:flex;flex-direction:column;gap:8px"><h2 class="h3">{b.titel}</h2><p class="muted"><R t={b.tekst} lang={lang} /></p><a class='more' href={blockLinks[i]}>{b.link}</a></div>)}</div></section><section class="sec"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:start"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">{c.over.titel}</h2><p class="lead"><R t={c.over.lead} lang={lang} /></p><p class="muted"><R t={c.over.tekst} lang={lang} /></p></div><div class="panel" style="display:flex;flex-direction:column;gap:8px"><h3 class="h3">{c.voor_wie.titel}</h3><ul class="rule-list" style="list-style:none">{c.voor_wie.punten.map((p: string) => <li><span class="dot" aria-hidden="true"></span><span><R t={p} lang={lang} /></span></li>)}</ul></div></div></section><section class="sec" style="padding-top:0"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.beeld.titel}</h2><p class="lead muted" style="max-width:760px"><R t={c.beeld.lead} lang={lang} /></p></div><div class="mosaic">{photos.map(([src, cls, st], i) => <figure class={cls} style={st}><Photo class="photo" name={src} alt={c.beeld.alt[i] ?? ''} sizes="(max-width: 760px) 50vw, 50vw" /></figure>)}</div></div></section><section class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.meedoen.titel}</h2></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(440px,100%),1fr));gap:0 56px">{c.meedoen.acties.map((a: any, i: number) => <a class='action' href={actionLinks[i]}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]}></svg></span><h3 class="h3 action-title" style="padding-top:4px">{a.titel}</h3><p class="muted"><R t={a.tekst} lang={lang} /></p></a>)}</div></div></section><section class="sec"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.comite.titel}</h2></div><ul class="grid" style="list-style:none;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:0 28px">{comite().map((m: any) => <li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px" set:html={orPh(m.naam, phName)}></span><span class="muted" style="font-size:16px" set:html={orPh(tr(m.functie, lang), phRole)}></span></li>)}</ul></div></section><section style="background:#FFFFFF;border-top:1px solid #DADDE8;padding:56px 0"><div class="wrap" style="display:flex;flex-direction:column;gap:22px"><div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:12px"><h2 class="h3">{c.sponsors.titel}</h2><a class='more' href={path(lang, 'sponsors')}>{c.sponsors.link}</a></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr));gap:16px"><SponsorTiles niveau="platinum" placeholders={4} tileStyle="min-height:104px" /></div></div></section><section class="night" style="padding:clamp(64px,8vw,104px) 0;border-bottom:1px solid rgba(233,234,244,0.1)"><div class="wrap" style="display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between"><div style="display:flex;flex-direction:column;gap:12px;max-width:700px"><h2 class="h2" style="color:#FFFFFF">{c.afsluiter.titel}</h2><p class="lead" style="color:#C9CDE3"><R t={c.afsluiter.tekst[status]} lang={lang} /></p></div><div style="display:flex;flex-wrap:wrap;gap:12px"><a class='btn btn-primary' href={path(lang, 'registratie')}>{c.afsluiter.knop_registreren}</a><a class='btn btn-ghost' href={path(lang, 'contact')}>{c.afsluiter.knop_contact}</a></div></div></section></div>
</BaseLayout>
