---
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import Photo from '../Photo.astro';
import SponsorTiles from '../SponsorTiles.astro';
import type { Lang } from '../../i18n/routes';
import { page, settings, sponsors } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'sponsors');
const email = settings().contact?.email ?? 'info@jcc-congressen.nl';
const mailto = `mailto:${email}?subject=${encodeURIComponent(c.sponsor_worden.mail_onderwerp)}`;
const heeftExposanten = sponsors().some((x: any) => x.niveau === 'exposant');
const levels = [
  { key: 'platinum', n: 4, grid: 'list-style:none;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr))', tile: 'min-height:150px;font-size:17px' },
  { key: 'goud', n: 6, grid: 'list-style:none;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr))', tile: 'min-height:110px;font-size:16px' },
  { key: 'zilver', n: 8, grid: 'list-style:none;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(140px,100%),1fr))', tile: 'min-height:88px;font-size:15px' },
  ...(heeftExposanten ? [{ key: 'exposant', n: 0, grid: 'list-style:none;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(140px,100%),1fr))', tile: 'min-height:88px;font-size:15px' }] : []),
] as const;
---

<BaseLayout lang={lang} page="sponsors" title={c.seo.titel} description={c.seo.omschrijving} ogImage="slaap-expo_foto268.jpg">
<section class="night" style="position:relative;padding-top:clamp(80px,10vw,144px);overflow:hidden"><Photo class="hero-media" name="slaap-expo_foto268.jpg" alt="" priority /><div class="shade-side" aria-hidden="true"></div><div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:20px;padding-bottom:clamp(64px,8vw,104px)"><h1 style="font-size:clamp(40px,5.6vw,72px);font-weight:800;color:#FFFFFF;max-width:920px">{c.hero.titel}</h1><p class="lead" style="color:#C9CDE3;max-width:760px"><R t={c.hero.lead} lang={lang} /></p><div style="margin-top:8px"><a class="btn btn-primary" href={mailto}>{c.hero.knop}</a></div></div></section><section class="sec"><div class="wrap" style="display:flex;flex-direction:column;gap:56px">{levels.map((l) => <div style="display:flex;flex-direction:column;gap:18px"><h2 class="h3">{c.niveaus[l.key]}</h2><ul class="grid" style={l.grid}><SponsorTiles niveau={l.key} placeholders={l.n} tag="li" tileStyle={l.tile} /></ul></div>)}</div></section><section class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,88px);align-items:start"><div style="display:flex;flex-direction:column;gap:18px"><h2 class="h2">{c.sponsor_worden.titel}</h2><p class="lead muted"><R t={c.sponsor_worden.lead} lang={lang} /></p><div style="display:flex;flex-wrap:wrap;gap:12px"><a class="btn btn-dark" href={mailto}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>{email}</a></div></div><div class="panel" style="display:flex;flex-direction:column;gap:12px;background:#F3F4F9"><h3 class="h3">{c.cgr.titel}</h3><p class="muted" style="font-size:16px"><R t={c.cgr.tekst1} lang={lang} /></p><p class="muted" style="font-size:16px"><R t={c.cgr.tekst2} lang={lang} /></p></div></div></section>
</BaseLayout>
