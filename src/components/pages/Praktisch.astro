---
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import Photo from '../Photo.astro';
import type { Lang } from '../../i18n/routes';
import { page, settings, accreditatie, tr, orPh } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'praktisch');
const s = settings();
const k = s.congres;
const accr: any[] = accreditatie();
const q = encodeURIComponent(`${k.locatie_kort} ${k.adres} ${k.plaats}`).replace(/%20/g, '+');
const tel = `tel:${String(c.locatie.telefoon).replace(/\(0\)/, '').replace(/[^+\d]/g, '')}`;
const anchors = ['locatie', 'hotel', 'route', 'accreditatie'];
const ext = '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>';
---

<BaseLayout lang={lang} page="praktisch" title={c.seo.titel} description={c.seo.omschrijving} ogImage="slaap-netwerken_foto141.jpg">
<section class="night" style="position:relative;padding-top:clamp(80px,10vw,144px);overflow:hidden"><Photo class="hero-media" name="slaap-netwerken_foto141.jpg" alt="" priority /><div class="shade-side" aria-hidden="true"></div><div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:20px;padding-bottom:clamp(64px,8vw,104px)"><h1 style="font-size:clamp(40px,5.6vw,72px);font-weight:800;color:#FFFFFF;max-width:920px">{c.hero.titel}</h1><p class="lead" style="color:#C9CDE3;max-width:760px"><R t={c.hero.lead} lang={lang} /></p><nav aria-label={lang === 'nl' ? 'Op deze pagina' : 'On this page'} style="display:flex;flex-wrap:wrap;gap:10px;margin-top:8px">{c.hero.ankers.map((x: string, i: number) => <a class="chip" href={`#${anchors[i]}`}>{x}</a>)}</nav></div></section><section id="locatie" class="sec" style="scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:32px;align-items:stretch"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">{c.locatie.titel}</h2><address class="panel" style="font-style:normal;display:flex;flex-direction:column;gap:14px"><p><strong>{k.locatie_volledig}</strong><br>{k.adres}<br>{k.postcode} {k.plaats}</p><p style="display:flex;flex-direction:column;gap:4px"><a href={tel}>{c.locatie.telefoon}</a><a href={`mailto:${c.locatie.email}`}>{c.locatie.email}</a><a href={c.locatie.website}>{c.locatie.website_label}</a></p></address></div><div class="panel-night" style="position:relative;min-height:340px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center;background-image:linear-gradient(rgba(110,195,238,0.08) 1px,transparent 1px),linear-gradient(90deg,rgba(110,195,238,0.08) 1px,transparent 1px);background-size:40px 40px"><span style="color:#6EC3EE"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"></circle></svg></span><p style="font-weight:700;color:#FFFFFF"><R t={c.locatie.kaart} lang={lang} /></p><a class="btn btn-primary" href={`https://www.google.com/maps/search/?api=1&query=${q}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ext}></svg>{c.locatie.knop_maps}</a></div></div></section><section id="hotel" class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8;scroll-margin-top:24px"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:40px;align-items:center"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.hotel.titel}</h2><p class="lead muted" style="max-width:760px"><R t={c.hotel.lead} lang={lang} /></p></div><div><a class="btn btn-dark" href={s.links?.hotel_boeken || '#'}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18V7M3 14h18v4M21 14v-2a3 3 0 0 0-3-3h-7v5"></path><circle cx="7" cy="11" r="2"></circle></svg>{c.hotel.knop}</a></div></div></section><section id="route" class="sec" style="scroll-margin-top:24px"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.route.titel}</h2></div><a class="btn btn-outline" href={`https://www.google.com/maps/dir/?api=1&destination=${q}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ext}></svg>{c.route.knop}</a></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr))"><div class="panel" style="display:flex;gap:18px;align-items:flex-start"><span class="action-icon" style="flex:0 0 56px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 16V11l2-5h10l2 5v5M3 16h18v3H3zM5 11h14"></path><circle cx="7.5" cy="16" r="0.5"></circle><circle cx="16.5" cy="16" r="0.5"></circle></svg></span><div style="display:flex;flex-direction:column;gap:8px"><h3 class="h3">{c.route.auto_titel}</h3><p class="muted"><R t={c.route.auto_tekst} lang={lang} /></p></div></div><div class="panel" style="display:flex;gap:18px;align-items:flex-start"><span class="action-icon" style="flex:0 0 56px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="14" rx="3"></rect><path d="M5 11h14M8 21l2-4M16 21l-2-4"></path><circle cx="9" cy="14" r="0.6"></circle><circle cx="15" cy="14" r="0.6"></circle></svg></span><div style="display:flex;flex-direction:column;gap:8px"><h3 class="h3">{c.route.ov_titel}</h3><p class="muted"><R t={c.route.ov_tekst} lang={lang} /></p></div></div></div></div></section><section id="accreditatie" class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8;scroll-margin-top:24px"><div class="wrap" style="display:flex;flex-direction:column;gap:28px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">{c.accreditatie.titel}</h2><p class="lead muted" style="max-width:760px"><R t={c.accreditatie.lead} lang={lang} /></p></div><div class="tbl-box"><table class="tbl"><caption style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">{c.accreditatie.bijschrift}</caption><thead><tr><th scope="col">{c.accreditatie.kolom_vereniging}</th><th scope="col">{c.accreditatie.kolom_punten}</th></tr></thead><tbody>{accr.map((v) => <tr><td>{tr(v.naam, lang)}</td><td class="tabular" style="white-space:nowrap"><Fragment set:html={orPh(v.punten, '[n]')} /> {c.accreditatie.punten}</td></tr>)}</tbody></table></div><p class="muted" style="font-size:16px;max-width:880px"><R t={c.accreditatie.voetnoot} lang={lang} /></p></div></section>
</BaseLayout>
