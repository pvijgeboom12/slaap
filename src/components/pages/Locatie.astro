---
// Pagina Locatie (fase 1). Teksten: src/content/pages/{nl,en}/locatie.yml. Adres en hotellink: settings.yml.
import BaseLayout from '../../layouts/BaseLayout.astro';
import R from '../R.astro';
import Photo from '../Photo.astro';
import { type Lang } from '../../i18n/routes';
import { page, settings } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = page(lang, 'locatie');
const s = settings();
const cg = s.congres;
const naam = cg.locatie_volledig || cg.locatie;
const plaatsregel = [cg.postcode, cg.plaats].filter(Boolean).join(' ');
const query = encodeURIComponent([naam, cg.adres, plaatsregel].filter(Boolean).join(', '));
const routeUrl = `https://www.google.com/maps/search/?api=1&query=${query}`;
const mapUrl = `https://www.google.com/maps?q=${query}&output=embed`;
const hotel: string = s.links?.hotel_boeken || '';
const pin = '<path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"></circle>';
---

<BaseLayout lang={lang} page="locatie" title={c.seo.titel} description={c.seo.omschrijving} ogImage="slaap-publiek_foto287.jpg">
<section class="night" style="position:relative;padding-top:clamp(80px,10vw,144px);overflow:hidden"><Photo class="hero-media" name="slaap-publiek_foto287.jpg" alt="" priority /><div class="shade-side" aria-hidden="true"></div><div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:20px;padding-bottom:clamp(64px,8vw,104px)"><h1 style="font-size:clamp(40px,5.6vw,72px);font-weight:800;color:#FFFFFF;max-width:920px">{c.hero.titel}</h1><p class="lead" style="color:#E9EAF4;max-width:760px"><R t={c.hero.lead} lang={lang} /></p><p style="color:#C9CDE3;max-width:760px"><R t={c.hero.tekst} lang={lang} /></p></div></section>

<section class="sec"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:clamp(32px,5vw,64px);align-items:start"><div class="panel" style="display:flex;flex-direction:column;gap:16px"><h2 class="h3">{c.adres.titel}</h2><div style="display:flex;gap:12px;align-items:flex-start"><span style="color:#155A8A;margin-top:3px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pin}></svg></span><address style="font-style:normal"><strong>{naam}</strong><br>{cg.adres}<br>{plaatsregel}</address></div><div><a class="btn btn-primary" href={routeUrl} rel="noopener">{c.adres.knop}</a></div></div><div style="border-radius:20px;overflow:hidden;border:1px solid #DADDE8;aspect-ratio:4 / 3;background:#E6E8F0"><iframe title={c.adres.kaart_titel} src={mapUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="display:block;width:100%;height:100%;border:0"></iframe></div></div></section>

<section class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8;border-bottom:1px solid #DADDE8"><div class="wrap" style="display:flex;flex-direction:column;gap:28px"><h2 class="h2">{c.bereikbaarheid.titel}</h2><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:24px">{c.bereikbaarheid.items.map((b: { titel: string; tekst: string }) => <div class="panel" style="display:flex;flex-direction:column;gap:10px"><h3 class="h3">{b.titel}</h3><p class="muted"><R t={b.tekst} lang={lang} /></p></div>)}</div></div></section>

<section id="hotel" class="night" style="padding:clamp(64px,8vw,104px) 0"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:center"><div style="display:flex;flex-direction:column;gap:16px"><h2 class="h2" style="color:#FFFFFF">{c.overnachten.titel}</h2><p class="lead" style="color:#C9CDE3"><R t={c.overnachten.tekst} lang={lang} /></p></div>{hotel ? <div><a class="btn btn-primary" href={hotel} rel="noopener">{c.overnachten.knop}</a></div> : c.overnachten.volgt ? <div><p class="soft"><R t={c.overnachten.volgt} lang={lang} /></p></div> : null}</div></section>
</BaseLayout>
