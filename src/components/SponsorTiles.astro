---
// Logotegels per sponsorniveau. Zolang er voor een niveau nog geen sponsors zijn,
// tonen we het aantal lege [Logo]-tegels uit het ontwerp (placeholders).
import { sponsors } from '../lib/content';
interface Props {
  niveau: 'platinum' | 'goud' | 'zilver' | 'exposant';
  placeholders: number;
  tag?: 'div' | 'li';
  tileStyle: string;
}
const { niveau, placeholders, tag = 'div', tileStyle } = Astro.props;
const list = sponsors().filter((s: any) => s.niveau === niveau);
const Tag = tag;
---
{list.length
  ? list.map((s: any) => {
      const img = s.logo ? <img src={s.logo} alt={s.naam} loading="lazy" style="display:block;max-width:100%;max-height:72px;width:auto;height:auto;object-fit:contain" /> : s.naam;
      return (
        <Tag class="logo-tile" style={`${tileStyle};border-style:solid;border-color:#DADDE8`}>
          {s.link ? <a href={s.link} style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:inherit;text-decoration:none">{img}</a> : img}
        </Tag>
      );
    })
  : Array.from({ length: placeholders }).map(() => <Tag class="logo-tile" style={tileStyle}>[Logo]</Tag>)}
