---
import BaseLayout from '../layouts/BaseLayout.astro';
import { path } from '../i18n/routes';
---

<BaseLayout lang="nl" page="home" title="Home">
<div lang="nl"><section class="night" style="position:relative;overflow:hidden"><img class="hero-media" src="/assets/slaap-hero_foto272.jpg" alt="" width="1920" height="1280"><div class="shade-home" aria-hidden="true"></div><div class="wrap" style="position:relative;padding-top:clamp(80px,11vw,168px);padding-bottom:clamp(56px,7vw,96px);display:flex;flex-direction:column;gap:clamp(40px,5vw,64px)"><div style="display:flex;flex-direction:column;gap:clamp(16px,2vw,24px)"><p style="font-size:clamp(20px,1.8vw,24px);font-weight:600;color:#C9CDE3">Nederlands Slaapcongres</p><h1 style="margin:0;line-height:0"><img src="/assets/slaap2027-woordmerk-donker.svg" alt="SLAAP2027" width="1104" height="142" style="display:block;width:100%;max-width:1104px;height:auto"></h1></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:40px;align-items:end"><div style="display:flex;flex-direction:column;gap:22px"><p class="lead" style="color:#E9EAF4;max-width:540px">Het tweejaarlijkse congres voor iedereen die werkt in de slaapwetenschap en slaapgeneeskunde.</p><div style="display:flex;flex-wrap:wrap;gap:12px"><a class='btn btn-primary' href={path('nl', 'registratie')}>Registreren</a><a class='btn btn-ghost' href={path('nl', 'abstracts')}>Abstract indienen</a></div><p style="font-size:16px;color:#A9AECB">Registratie en abstractindiening openen op <em class="ph">[datum]</em>.</p></div><div class="panel-night" style="display:flex;flex-direction:column;gap:22px;width:100%;max-width:460px;justify-self:end"><p style="font-weight:700;color:#A9D9F4">November 2027</p><div class="grid" style="grid-template-columns:repeat(3,minmax(0,1fr));gap:12px"><div style="display:flex;flex-direction:column;gap:6px"><span class="disp tabular" style="font-size:clamp(48px,5vw,68px);font-weight:700;line-height:1;color:#FFFFFF">10</span><span style="font-size:15px;font-weight:600;color:#A9AECB">woensdag</span></div><div style="display:flex;flex-direction:column;gap:6px"><span class="disp tabular" style="font-size:clamp(48px,5vw,68px);font-weight:700;line-height:1;color:#FFFFFF">11</span><span style="font-size:15px;font-weight:600;color:#A9AECB">donderdag</span></div><div style="display:flex;flex-direction:column;gap:6px"><span class="disp tabular" style="font-size:clamp(48px,5vw,68px);font-weight:700;line-height:1;color:#FFFFFF">12</span><span style="font-size:15px;font-weight:600;color:#A9AECB">vrijdag</span></div></div><div style="height:1px;background:rgba(110,195,238,0.2)"></div><div style="display:flex;gap:12px;align-items:flex-start"><span style="color:#6EC3EE;margin-top:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"></circle></svg></span><div><p style="font-weight:700;color:#FFFFFF">NH Conference Centre Koningshof</p><p class="soft">Veldhoven</p></div></div><a class='more' href={path('nl', 'praktisch')} style='color:#6EC3EE'>Route en hotel</a></div></div></div></section><section style="background:#FFFFFF;border-bottom:1px solid #DADDE8"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:0 32px"><div style="padding:30px 28px 26px 0;display:flex;flex-direction:column;gap:8px"><h2 class="h3">Datum en locatie</h2><p class="muted">Woensdag 10 t/m vrijdag 12 november 2027 in NH Koningshof, Veldhoven.</p><a class='more' href={path('nl', 'praktisch')}>Route en hotel</a></div><div style="padding:30px 28px 26px 0;display:flex;flex-direction:column;gap:8px"><h2 class="h3">Programma</h2><p class="muted">Keynotes, parallelle symposia, posters met Data Blitz en het congresdiner.</p><a class='more' href={path('nl', 'programma')}>Bekijk het programma</a></div><div style="padding:30px 28px 26px 0;display:flex;flex-direction:column;gap:8px"><h2 class="h3">Accreditatie</h2><p class="muted">Accreditatie wordt aangevraagd bij de relevante beroepsverenigingen.</p><a class='more' href={path('nl', 'praktisch', 'accreditatie')}>Punten per vereniging</a></div></div></section><section class="sec"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:start"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">Waar slaaponderzoek en slaapzorg elkaar treffen</h2><p class="lead">SLAAP2027 brengt onderzoekers, clinici en zorgprofessionals uit de slaapwetenschap en slaapgeneeskunde samen. Drie dagen met keynotes, symposia, posterpresentaties en tijd om bij te praten met collega's. Er zijn Nederlandstalige en Engelstalige sessies.</p><p class="muted">Het congres wordt om de twee jaar georganiseerd door de Nederlandse Vereniging voor Slaap-Waak Onderzoek (NSWO) en de Nederlandse Vereniging voor Slaapgeneeskunde (SVNL), onder Stichting Slaapcongres Nederland. We verwachten circa 600 deelnemers.</p></div><div class="panel" style="display:flex;flex-direction:column;gap:8px"><h3 class="h3">Voor wie?</h3><ul class="rule-list" style="list-style:none"><li><span class="dot" aria-hidden="true"></span><span>Artsen, onderzoekers en zorgprofessionals in de slaapgeneeskunde en slaapwetenschap, lid of geen lid van NSWO of SVNL</span></li><li><span class="dot" aria-hidden="true"></span><span>(PhD-)studenten en young professionals</span></li><li><span class="dot" aria-hidden="true"></span><span>Sprekers en symposiumvoorzitters</span></li><li><span class="dot" aria-hidden="true"></span><span>Sponsoren en exposanten uit farma en medtech</span></li><li><span class="dot" aria-hidden="true"></span><span>Iedereen met belangstelling voor slaap en waak</span></li></ul></div></div></section><section class="sec" style="padding-top:0"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">SLAAP2025 in beeld</h2><p class="lead muted" style="max-width:760px">Een indruk van de vorige editie in NH Koningshof: keynotes, posters, ontmoetingen en het congresdiner.</p></div><div class="mosaic"><figure class="wide" style="grid-column:1 / span 3;grid-row:1 / span 4"><img class="photo" src="/assets/slaap-sprekers_foto73.jpg" alt="Keynote in de plenaire zaal" loading="lazy"></figure><figure class="" style="grid-column:4 / span 3;grid-row:1 / span 2"><img class="photo" src="/assets/slaap-posters_foto199.jpg" alt="Deelnemers in gesprek bij de posters" loading="lazy"></figure><figure class="" style="grid-column:4 / span 2;grid-row:3 / span 2"><img class="photo" src="/assets/slaap-netwerken_foto99.jpg" alt="Netwerken tijdens de pauze" loading="lazy"></figure><figure class="" style="grid-column:6 / span 1;grid-row:3 / span 2"><img class="photo" src="/assets/slaap-publiek_foto287.jpg" alt="Publiek tijdens een sessie" loading="lazy"></figure><figure class="wide" style="grid-column:1 / span 4;grid-row:5 / span 3"><img class="photo" src="/assets/slaap-diner-feest_foto230.jpg" alt="Dansvloer en band op het congresdiner" loading="lazy"></figure><figure class="" style="grid-column:5 / span 2;grid-row:5 / span 3"><img class="photo" src="/assets/slaap-awards_foto331.jpg" alt="Uitreiking van de Piet Visser Posterprijs" loading="lazy"></figure></div></div></section><section class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">Doe mee aan SLAAP2027</h2></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(440px,100%),1fr));gap:0 56px"><a class='action' href={path('nl', 'registratie')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4z"></path><path d="M14 6v12" stroke-dasharray="2 2.5"></path></svg></span><h3 class="h3 action-title" style="padding-top:4px">Registreren</h3><p class="muted">Tarieven per categorie, groepsregistratie en voorwaarden.</p></a><a class='action' href={path('nl', 'abstracts')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5M10 13h6M10 17h6"></path></svg></span><h3 class="h3 action-title" style="padding-top:4px">Abstract of symposium indienen</h3><p class="muted">Presenteer je onderzoek als poster en pitch het in de Data Blitz. Deadline <em class="ph">[datum]</em>.</p></a><a class='action' href={path('nl', 'praktisch', 'hotel')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18V7M3 14h18v4M21 14v-2a3 3 0 0 0-3-3h-7v5"></path><circle cx="7" cy="11" r="2"></circle></svg></span><h3 class="h3 action-title" style="padding-top:4px">Hotelkamer boeken</h3><p class="muted">Overnacht op de congreslocatie. Boek op tijd voor de meeste keus.</p></a><a class='action' href={path('nl', 'sponsors')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5.5"></circle><path d="M8.6 13.6L7 21l5-3 5 3-1.6-7.4"></path></svg></span><h3 class="h3 action-title" style="padding-top:4px">Sponsor worden</h3><p class="muted">Ontmoet circa 600 slaapprofessionals op de congresvloer.</p></a><a class='action' href={path('nl', 'registratie', 'lid-worden')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.6a3.5 3.5 0 0 1 0 6.8M17.5 14.4a6.5 6.5 0 0 1 4 5.6"></path></svg></span><h3 class="h3 action-title" style="padding-top:4px">Lid worden van NSWO of SVNL</h3><p class="muted">Leden registreren tegen een gereduceerd tarief.</p></a></div></div></section><section class="sec"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">Organisatiecomité</h2></div><ul class="grid" style="list-style:none;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:0 28px"><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Naam]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Functie, instelling]</em></span></li><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Naam]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Functie, instelling]</em></span></li><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Naam]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Functie, instelling]</em></span></li><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Naam]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Functie, instelling]</em></span></li><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Naam]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Functie, instelling]</em></span></li></ul></div></section><section style="background:#FFFFFF;border-top:1px solid #DADDE8;padding:56px 0"><div class="wrap" style="display:flex;flex-direction:column;gap:22px"><div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:12px"><h2 class="h3">Platinum sponsors</h2><a class='more' href={path('nl', 'sponsors')}>Alle sponsors</a></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr));gap:16px"><div class="logo-tile" style="min-height:104px">[Logo]</div><div class="logo-tile" style="min-height:104px">[Logo]</div><div class="logo-tile" style="min-height:104px">[Logo]</div><div class="logo-tile" style="min-height:104px">[Logo]</div></div></div></section><section class="night" style="padding:clamp(64px,8vw,104px) 0;border-bottom:1px solid rgba(233,234,244,0.1)"><div class="wrap" style="display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between"><div style="display:flex;flex-direction:column;gap:12px;max-width:700px"><h2 class="h2" style="color:#FFFFFF">Zet 10 t/m 12 november 2027 in je agenda</h2><p class="lead" style="color:#C9CDE3">Registratie opent op <em class="ph">[datum]</em>. Leden van NSWO en SVNL registreren met korting.</p></div><div style="display:flex;flex-wrap:wrap;gap:12px"><a class='btn btn-primary' href={path('nl', 'registratie')}>Registreren</a><a class='btn btn-ghost' href={path('nl', 'contact')}>Neem contact op</a></div></div></section></div>
</BaseLayout>
