---
import BaseLayout from '../layouts/BaseLayout.astro';
import { path } from '../i18n/routes';
---

<BaseLayout lang="nl" page="contact" title="Contact">
<section class="night" style="position:relative;padding-top:clamp(80px,10vw,144px);overflow:hidden"><img class="hero-media" src="/assets/slaap-netwerken_foto90.jpg" alt="" width="1920" height="1280"><div class="shade-side" aria-hidden="true"></div><div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:20px;padding-bottom:clamp(64px,8vw,104px)"><h1 style="font-size:clamp(40px,5.6vw,72px);font-weight:800;color:#FFFFFF;max-width:920px">Vragen over SLAAP2027?</h1><p class="lead" style="color:#C9CDE3;max-width:760px">De congresorganisatie is in handen van JCC Congress Consultancy &amp; Events. Stuur een bericht via het formulier of mail naar <a href="mailto:info@jcc-congressen.nl" style="color:#6EC3EE">info@jcc-congressen.nl</a>.</p></div></section><section class="sec"><div class="wrap" style="display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,64px);align-items:flex-start"><div class="panel" style="flex:999 1 560px;min-width:0"><div id="form-view"><div style="display:flex;flex-direction:column;gap:20px"><h2 id="form-title" class="h2" style="font-size:32px">Stuur een bericht</h2><p class="muted" style="font-size:16px">Velden met <span style="color:#155A8A">*</span> zijn verplicht.</p><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:18px"><div class="field"><label for="f-first">Voornaam <span aria-hidden="true" style="color:#155A8A">*</span></label><input class="input" id="f-first" type="text" autocomplete="given-name" aria-required="true" value=""></div><div class="field"><label for="f-last">Achternaam <span aria-hidden="true" style="color:#155A8A">*</span></label><input class="input" id="f-last" type="text" autocomplete="family-name" aria-required="true" value=""></div></div><div class="field"><label for="f-email">E-mailadres <span aria-hidden="true" style="color:#155A8A">*</span></label><input class="input" id="f-email" type="email" autocomplete="email" aria-required="true" value=""></div><div class="field"><label for="f-org">Organisatie</label><input class="input" id="f-org" type="text" autocomplete="organization" value=""></div><div class="field"><label for="f-msg">Bericht</label><textarea class="input" id="f-msg" rows="6" style="resize:vertical" value=""></textarea></div><div aria-live="polite"><div id="form-error" hidden><p style="padding:12px 16px;border-radius:12px;background:#FBE4E4;color:#8A1C1C;font-weight:600"></p></div></div><div><button type="button" class="btn btn-dark" id="f-submit">Verstuur bericht</button></div></div></div><div id="sent-view" hidden><div role="status" style="display:flex;flex-direction:column;gap:16px;align-items:flex-start"><h2 class="h2" style="font-size:32px">Bedankt, <span data-f="first"></span></h2><p class="muted">Je e-mailprogramma is geopend met je bericht aan info@jcc-congressen.nl. Verstuur die mail om je vraag in te dienen.</p><button type="button" class="btn btn-outline" id="f-reset">Nog een bericht sturen</button></div></div></div><aside style="flex:1 1 300px;display:flex;flex-direction:column;gap:24px"><div class="panel-night" style="display:flex;flex-direction:column;gap:12px"><h2 class="h3" style="color:#FFFFFF">Congresorganisatie</h2><p>JCC Congress Consultancy &amp; Events</p><a class="more" href="mailto:info@jcc-congressen.nl" style="color:#6EC3EE;gap:10px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>info@jcc-congressen.nl</a></div><div style="display:flex;flex-direction:column;gap:10px;padding:4px 4px 0"><h2 class="h3">Snel geregeld</h2><a class='more' href={path('nl', 'registratie')}>Vragen over registratie en tarieven</a><a class='more' href={path('nl', 'abstracts')}>Abstracts en posters</a><a class='more' href={path('nl', 'sponsors')}>Sponsoring en stands</a><a class='more' href={path('nl', 'praktisch')}>Route en hotel</a></div></aside></div></section>
</BaseLayout>
