---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { path } from '../../i18n/routes';
---

<BaseLayout lang="en" page="home" title="Home">
<div lang="en"><section class="night" style="position:relative;overflow:hidden"><img class="hero-media" src="/assets/slaap-hero_foto272.jpg" alt="" width="1920" height="1280"><div class="shade-home" aria-hidden="true"></div><div class="wrap" style="position:relative;padding-top:clamp(80px,11vw,168px);padding-bottom:clamp(56px,7vw,96px);display:flex;flex-direction:column;gap:clamp(40px,5vw,64px)"><div style="display:flex;flex-direction:column;gap:clamp(16px,2vw,24px)"><p style="font-size:clamp(20px,1.8vw,24px);font-weight:600;color:#C9CDE3">Dutch Sleep Congress</p><h1 style="margin:0;line-height:0"><img src="/assets/slaap2027-woordmerk-donker.svg" alt="SLAAP2027" width="1104" height="142" style="display:block;width:100%;max-width:1104px;height:auto"></h1></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:40px;align-items:end"><div style="display:flex;flex-direction:column;gap:22px"><p class="lead" style="color:#E9EAF4;max-width:540px">The biennial congress for everyone working in sleep science and sleep medicine.</p><div style="display:flex;flex-wrap:wrap;gap:12px"><a class='btn btn-primary' href={path('en', 'registratie')}>Register</a><a class='btn btn-ghost' href={path('en', 'abstracts')}>Submit an abstract</a></div><p style="font-size:16px;color:#A9AECB">Registration and abstract submission open on <em class="ph">[date]</em>.</p></div><div class="panel-night" style="display:flex;flex-direction:column;gap:22px;width:100%;max-width:460px;justify-self:end"><p style="font-weight:700;color:#A9D9F4">November 2027</p><div class="grid" style="grid-template-columns:repeat(3,minmax(0,1fr));gap:12px"><div style="display:flex;flex-direction:column;gap:6px"><span class="disp tabular" style="font-size:clamp(48px,5vw,68px);font-weight:700;line-height:1;color:#FFFFFF">10</span><span style="font-size:15px;font-weight:600;color:#A9AECB">Wednesday</span></div><div style="display:flex;flex-direction:column;gap:6px"><span class="disp tabular" style="font-size:clamp(48px,5vw,68px);font-weight:700;line-height:1;color:#FFFFFF">11</span><span style="font-size:15px;font-weight:600;color:#A9AECB">Thursday</span></div><div style="display:flex;flex-direction:column;gap:6px"><span class="disp tabular" style="font-size:clamp(48px,5vw,68px);font-weight:700;line-height:1;color:#FFFFFF">12</span><span style="font-size:15px;font-weight:600;color:#A9AECB">Friday</span></div></div><div style="height:1px;background:rgba(110,195,238,0.2)"></div><div style="display:flex;gap:12px;align-items:flex-start"><span style="color:#6EC3EE;margin-top:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"></circle></svg></span><div><p style="font-weight:700;color:#FFFFFF">NH Conference Centre Koningshof</p><p class="soft">Veldhoven</p></div></div><a class='more' href={path('en', 'praktisch')} style='color:#6EC3EE'>Directions and hotel</a></div></div></div></section><section style="background:#FFFFFF;border-bottom:1px solid #DADDE8"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:0 32px"><div style="padding:30px 28px 26px 0;display:flex;flex-direction:column;gap:8px"><h2 class="h3">Date and venue</h2><p class="muted">Wednesday 10 to Friday 12 November 2027 at NH Koningshof, Veldhoven.</p><a class='more' href={path('en', 'praktisch')}>Directions and hotel</a></div><div style="padding:30px 28px 26px 0;display:flex;flex-direction:column;gap:8px"><h2 class="h3">Programme</h2><p class="muted">Keynotes, parallel symposia, posters with a Data Blitz, and the congress dinner.</p><a class='more' href={path('en', 'programma')}>View the programme</a></div><div style="padding:30px 28px 26px 0;display:flex;flex-direction:column;gap:8px"><h2 class="h3">Accreditation</h2><p class="muted">Accreditation is being requested from the relevant professional bodies.</p><a class='more' href={path('en', 'praktisch', 'accreditatie')}>Points per association</a></div></div></section><section class="sec"><div class="wrap grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:start"><div style="display:flex;flex-direction:column;gap:22px"><h2 class="h2">Where sleep research meets sleep care</h2><p class="lead">SLAAP2027 brings together researchers, clinicians and healthcare professionals in sleep science and sleep medicine. Three days of keynotes, symposia, poster presentations and time to catch up with colleagues. Sessions are held in Dutch and English.</p><p class="muted">The congress is organised every two years by the Dutch Society for Sleep-Wake Research (NSWO) and the Dutch Society for Sleep Medicine (SVNL), on behalf of Stichting Slaapcongres Nederland. We expect around 600 participants.</p></div><div class="panel" style="display:flex;flex-direction:column;gap:8px"><h3 class="h3">Who is it for?</h3><ul class="rule-list" style="list-style:none"><li><span class="dot" aria-hidden="true"></span><span>Physicians, researchers and healthcare professionals in sleep medicine and sleep science, members and non-members of NSWO or SVNL</span></li><li><span class="dot" aria-hidden="true"></span><span>(PhD) students and young professionals</span></li><li><span class="dot" aria-hidden="true"></span><span>Speakers and symposium chairs</span></li><li><span class="dot" aria-hidden="true"></span><span>Sponsors and exhibitors from pharma and medtech</span></li><li><span class="dot" aria-hidden="true"></span><span>Anyone with an interest in sleep and wakefulness</span></li></ul></div></div></section><section class="sec" style="padding-top:0"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">SLAAP2025 in pictures</h2><p class="lead muted" style="max-width:760px">A glimpse of the previous edition at NH Koningshof: keynotes, posters, conversations and the congress dinner.</p></div><div class="mosaic"><figure class="wide" style="grid-column:1 / span 3;grid-row:1 / span 4"><img class="photo" src="/assets/slaap-sprekers_foto73.jpg" alt="Keynote in the plenary hall" loading="lazy"></figure><figure class="" style="grid-column:4 / span 3;grid-row:1 / span 2"><img class="photo" src="/assets/slaap-posters_foto199.jpg" alt="Participants discussing posters" loading="lazy"></figure><figure class="" style="grid-column:4 / span 2;grid-row:3 / span 2"><img class="photo" src="/assets/slaap-netwerken_foto99.jpg" alt="Networking during the break" loading="lazy"></figure><figure class="" style="grid-column:6 / span 1;grid-row:3 / span 2"><img class="photo" src="/assets/slaap-publiek_foto287.jpg" alt="Audience during a session" loading="lazy"></figure><figure class="wide" style="grid-column:1 / span 4;grid-row:5 / span 3"><img class="photo" src="/assets/slaap-diner-feest_foto230.jpg" alt="Dance floor and band at the congress dinner" loading="lazy"></figure><figure class="" style="grid-column:5 / span 2;grid-row:5 / span 3"><img class="photo" src="/assets/slaap-awards_foto331.jpg" alt="Piet Visser Poster Prize ceremony" loading="lazy"></figure></div></div></section><section class="sec" style="background:#FFFFFF;border-top:1px solid #DADDE8"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">Take part in SLAAP2027</h2></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(440px,100%),1fr));gap:0 56px"><a class='action' href={path('en', 'registratie')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4z"></path><path d="M14 6v12" stroke-dasharray="2 2.5"></path></svg></span><h3 class="h3 action-title" style="padding-top:4px">Register</h3><p class="muted">Fees per category, group registration and terms.</p></a><a class='action' href={path('en', 'abstracts')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5M10 13h6M10 17h6"></path></svg></span><h3 class="h3 action-title" style="padding-top:4px">Submit an abstract or symposium</h3><p class="muted">Present your research as a poster and pitch it in the Data Blitz. Deadline <em class="ph">[date]</em>.</p></a><a class='action' href={path('en', 'praktisch', 'hotel')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18V7M3 14h18v4M21 14v-2a3 3 0 0 0-3-3h-7v5"></path><circle cx="7" cy="11" r="2"></circle></svg></span><h3 class="h3 action-title" style="padding-top:4px">Book a hotel room</h3><p class="muted">Stay at the congress venue. Book early for the widest choice.</p></a><a class='action' href={path('en', 'sponsors')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5.5"></circle><path d="M8.6 13.6L7 21l5-3 5 3-1.6-7.4"></path></svg></span><h3 class="h3 action-title" style="padding-top:4px">Become a sponsor</h3><p class="muted">Meet around 600 sleep professionals on the congress floor.</p></a><a class='action' href={path('en', 'registratie', 'lid-worden')}><span class="action-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.6a3.5 3.5 0 0 1 0 6.8M17.5 14.4a6.5 6.5 0 0 1 4 5.6"></path></svg></span><h3 class="h3 action-title" style="padding-top:4px">Join NSWO or SVNL</h3><p class="muted">Members register at a reduced fee.</p></a></div></div></section><section class="sec"><div class="wrap" style="display:flex;flex-direction:column;gap:32px"><div style="display:flex;flex-direction:column;gap:14px;max-width:820px"><h2 class="h2">Organising committee</h2></div><ul class="grid" style="list-style:none;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:0 28px"><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Name]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Role, institution]</em></span></li><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Name]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Role, institution]</em></span></li><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Name]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Role, institution]</em></span></li><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Name]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Role, institution]</em></span></li><li style="display:flex;flex-direction:column;gap:4px;padding:20px 0;border-top:2px solid #1B2140"><span style="font-weight:700;font-size:19px"><em class="ph">[Name]</em></span><span class="muted" style="font-size:16px"><em class="ph">[Role, institution]</em></span></li></ul></div></section><section style="background:#FFFFFF;border-top:1px solid #DADDE8;padding:56px 0"><div class="wrap" style="display:flex;flex-direction:column;gap:22px"><div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:12px"><h2 class="h3">Platinum sponsors</h2><a class='more' href={path('en', 'sponsors')}>All sponsors</a></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr));gap:16px"><div class="logo-tile" style="min-height:104px">[Logo]</div><div class="logo-tile" style="min-height:104px">[Logo]</div><div class="logo-tile" style="min-height:104px">[Logo]</div><div class="logo-tile" style="min-height:104px">[Logo]</div></div></div></section><section class="night" style="padding:clamp(64px,8vw,104px) 0;border-bottom:1px solid rgba(233,234,244,0.1)"><div class="wrap" style="display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between"><div style="display:flex;flex-direction:column;gap:12px;max-width:700px"><h2 class="h2" style="color:#FFFFFF">Save the date: 10 to 12 November 2027</h2><p class="lead" style="color:#C9CDE3">Registration opens on <em class="ph">[date]</em>. NSWO and SVNL members register at a reduced fee.</p></div><div style="display:flex;flex-wrap:wrap;gap:12px"><a class='btn btn-primary' href={path('en', 'registratie')}>Register</a><a class='btn btn-ghost' href={path('en', 'contact')}>Contact us</a></div></div></section></div>
</BaseLayout>
